# ═══════════════════════════════════════════════════════════
#  SETTL — Railway Environment Variables
#
#  Set ALL of these in:
#  Railway Dashboard → Your Project → Variables
#
#  Railway automatically sets PORT — do not set it yourself.
# ═══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
NODE_ENV=production
# PORT is set automatically by Railway — do not add it

# ── App URL (your Railway domain) ─────────────────────────
# After first deploy, Railway gives you a URL like:
# https://settl-production-xxxx.up.railway.app
# Set that here so payment links use the correct domain
APP_URL=https://your-app.up.railway.app

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── Custom Auth JWT ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-long-random-jwt-secret-min-32-characters

# ── Solana ────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SETTL_PROGRAM_ID=RZgHzaU8jKm4ydzwkmoooqd2TNek4L9W4o8tthekeLn
AUDD_MINT=your-audd-mint-address
TREASURY_WALLET=your-treasury-wallet-pubkey

# ── Authority Keypair ─────────────────────────────────────
# IMPORTANT: Do NOT use a file path on Railway.
# Instead, base64-encode your keypair.json and paste it here.
#
# To encode your keypair:
#   base64 -w 0 backend/keypair.json
#
# The server reads this env var and decodes it at startup.
# See backend/src/config/anchor.js for the decode logic.
AUTHORITY_KEYPAIR_BASE64=your-base64-encoded-keypair-json

# ── Phase 4 ───────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-signing-secret

# ── Email (optional) ──────────────────────────────────────
# Leave blank to disable email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
